grep -rni    # recursive/line numbers/ignore case
du -sh * | sort -h
CTRL + R  # we can use it twice to look in old history
journalctl -f # nowszy tail -f
journalctl -u nginx  -f   # tylko ostanie logi z nginxa na zywo
find . -name "*.log" -mtime +30    # szuka plikow niezmienianych od 30 dni
find . -name "*.log" -mtime +30 - exec rm {} /;    # usuwa te pliki stare od 30 dni!!!! najpierw sprawdz komenda wyzej, czy pliki sa dokladnie tymi, ktore chcesz usunac, bo nie ma UNDO
!$   # ostatnie slowo ostatniego polecenia, czyli np. mkdir /mnt/ppp/bbb,a potem cd !$ -> to cie tam przerzuci
watch -d free -h    #-d podswietla, co zmienilo sie od ostatniego odswiezenia

rsync -avh  --progress /project/ /mnt/backup/  # synchronizuje katalogi. Jak jest duzo plikow a malo sie zmienilo to idzie szybko. Nawet jak czesc pliku sie zmienila, to skopiuje czesc pliku. A jakby cos sie przerwalo, to potem leci dalej, nie od poczatku. Mozna nawet SSH uzywac do tego.!!
